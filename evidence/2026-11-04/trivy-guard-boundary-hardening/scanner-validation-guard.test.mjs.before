import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {GiB,validationHardFloor,productionRefreshRequirement,assessValidationBudget,
 loadValidationBudget,createLocalStorageSampler,scannerDatabaseIO,createValidationWorkspace,runOwnedValidationCommand,createValidationRefreshIO} from '../scanner-validation-guard.mjs';
const sha=x=>createHash('sha256').update(x).digest('hex');
// Synthetic budgets only: no actual Trivy peak evidence is claimed.
const proof=()=>({status:'PROVEN_CONSERVATIVE_UPPER_BOUND',artifactDigests:{db:'sha256:'+'a'.repeat(64),'java-db':'sha256:'+'d'.repeat(64)},evidenceSha256:'b'.repeat(64),evidenceIdentity:'SYNTHETIC_UNIT_ONLY',domains:[{id:'guest-and-host',identity:'synthetic-device',capacityBytes:100*GiB,peakAdditionalBytes:4*GiB,instantaneousWriteBytes:GiB,cleanupBytes:GiB,otherWriterBytes:GiB,peakAdditionalInodes:100,instantaneousWindowMs:4000,boundIncludesDownloadExtractionOldNewTemp:true,boundIncludesScanAndReports:true,cleanupProven:true,backingAllocationProven:true}]});
const sample=()=>({at:Date.now(),diskPressure:false,unownedWriter:false,ownerValid:true,domains:[{id:'guest-and-host',identity:'synthetic-device',capacityBytes:100*GiB,availableBytes:64*GiB,inodesFree:100000}]});
const assess=(s=sample(),b=proof())=>assessValidationBudget(s,b);
function temp(){const root=fs.mkdtempSync(path.join(os.tmpdir(),'trivy-guard-test-'));fs.chmodSync(root,0o700);return root;}
async function workspace(sampleFn=sample,budget=proof()) {const parent=temp(),w=await createValidationWorkspace({parent,runId:'trivy-validation-'+'a'.repeat(16),sample:sampleFn,budget});return {parent,w,done(){if(fs.existsSync(w.directory))w.cleanup();fs.rmSync(parent,{recursive:true,force:true});}};}
test('production default delegates frozen IO and ignores ambient validation environment',()=>{
 const old=process.env.TRIVY_GUARD_MODE;process.env.TRIVY_GUARD_MODE='validation-only';
 try{const io=scannerDatabaseIO();assert.deepEqual(Object.keys(io),['assertOwner','upstream','download','read']);}
 finally{if(old===undefined)delete process.env.TRIVY_GUARD_MODE;else process.env.TRIVY_GUARD_MODE=old;}
 assert.equal(productionRefreshRequirement(100*GiB),27*GiB);assert.equal(validationHardFloor(100*GiB),23*GiB);
});
for(const mode of ['validation','low','',null,'PRODUCTION'])test('invalid mode fails closed '+String(mode),()=>assert.throws(()=>scannerDatabaseIO({mode}),/EXPLICIT_VALIDATION/));
test('validation config cannot enter production',()=>assert.throws(()=>scannerDatabaseIO({validation:{floor:1}}),/VALIDATION_CONFIG_IN_PRODUCTION/));
test('validation mode has no production fallback',()=>{assert.throws(()=>scannerDatabaseIO({mode:'validation-only'}));assert.throws(()=>scannerDatabaseIO({mode:'validation-only',cacheDir:'/home/scanner/.cache/trivy',validation:{}}));});
test('exact boundary passes; one byte below fails',()=>{const b=proof(),s=sample();s.domains[0].availableBytes=30*GiB;assert.equal(assess(s,b).allowed,true);s.domains[0].availableBytes--;assert.equal(assess(s,b).allowed,false);});
test('monitor is not a substitute for peak budget',()=>{const b=proof();delete b.status;assert.equal(assessValidationBudget(sample(),b,Date.now(),true).allowed,false);});
for(const key of ['peakAdditionalBytes','instantaneousWriteBytes','cleanupBytes','otherWriterBytes','peakAdditionalInodes'])for(const v of [undefined,0,-1,NaN])test('invalid budget '+key+'/'+v,()=>{const b=proof();b.domains[0][key]=v;assert.equal(assess(sample(),b).allowed,false);});
for(const key of ['cleanupProven','backingAllocationProven','boundIncludesDownloadExtractionOldNewTemp','boundIncludesScanAndReports'])test('proof coverage required '+key,()=>{const b=proof();b.domains[0][key]=false;assert.equal(assess(sample(),b).allowed,false);});
for(const mutate of [s=>s.at-=1000,s=>s.at+=6000,s=>s.diskPressure=true,s=>s.ownerValid=false,s=>delete s.unownedWriter,s=>s.domains[0].identity='other',s=>s.domains[0].capacityBytes++,s=>s.domains[0].inodesFree=4000,s=>s.domains=[]])test('unsafe storage '+String(mutate),()=>{const s=sample();mutate(s);assert.equal(assess(s).allowed,false);});
test('backing domain cannot be omitted',()=>{const b=proof();b.domains.push({...b.domains[0],id:'physical-host',identity:'host'});assert.equal(assess(sample(),b).allowed,false);});
test('burst allowance covers full stop latency',()=>{const b=proof();b.domains[0].instantaneousWindowMs=3500;assert.equal(assess(sample(),b).allowed,false);});
test('numeric overflow cannot approve',()=>{const b=proof();b.domains[0].peakAdditionalBytes=Number.MAX_SAFE_INTEGER;assert.equal(assess(sample(),b).allowed,false);});
test('budget file hash, tamper and symlink checks',()=>{const d=temp();try{const f=d+'/proof.json',bytes=JSON.stringify(proof());fs.writeFileSync(f,bytes);assert.equal(loadValidationBudget(f,sha(bytes)).evidenceSha256,sha(bytes));fs.writeFileSync(f,bytes+' ');assert.throws(()=>loadValidationBudget(f,sha(bytes)),/HASH_MISMATCH/);fs.symlinkSync(f,d+'/link');assert.throws(()=>loadValidationBudget(d+'/link',sha(bytes)),/INVALID_BUDGET/);}finally{fs.rmSync(d,{recursive:true,force:true});}});
test('blocked preflight creates no run directory',async()=>{const parent=temp();try{await assert.rejects(createValidationWorkspace({parent,runId:'trivy-validation-'+'a'.repeat(16),sample,budget:{}}),/PREFLIGHT_BLOCKED/);assert.deepEqual(fs.readdirSync(parent),[]);}finally{fs.rmSync(parent,{recursive:true,force:true});}});
test('unsafe parent and run identity rejected',async()=>{const parent=temp();try{fs.chmodSync(parent,0o755);await assert.rejects(createValidationWorkspace({parent,runId:'trivy-validation-'+'a'.repeat(16),sample,budget:proof()}),/PRIVATE_TEMP_PARENT/);await assert.rejects(createValidationWorkspace({parent,runId:'../production',sample,budget:proof()}),/RUN_ID/);}finally{fs.rmSync(parent,{recursive:true,force:true});}});
test('running budget cannot be changed by caller',async()=>{const b=proof(),x=await workspace(sample,b);try{b.domains[0].cleanupBytes=1;assert.equal(x.w.budget.domains[0].cleanupBytes,GiB);assert.throws(()=>x.w.budget.domains[0].cleanupBytes=1);}finally{x.done();}});
test('REAL_CONTROLLED_EXECUTION success: isolated env and owned cleanup only',async()=>{const x=await workspace();const sentinel=x.parent+'/preserve';fs.writeFileSync(sentinel,'preserve');try{
 const r=await runOwnedValidationCommand(x.w,{binary:process.execPath,args:['-e',"if(process.env.HARBOR_PASS||process.env.KUBECONFIG)process.exit(3);require('fs').writeFileSync('tmp/owned','test');console.log('ok')"]});
 assert.equal(r.exitStatus,0);assert.equal(r.error,null);assert.equal(r.processGroupStopped,true);assert.match(r.log,/ok/);assert.equal(r.monitorIsPeakProof,false);assert.equal(x.w.cleanup().ownedWorkspaceRemoved,true);assert.equal(fs.readFileSync(sentinel,'utf8'),'preserve');}finally{x.done();}});
test('REAL_CONTROLLED_EXECUTION nonzero preserved',async()=>{const x=await workspace();try{const r=await runOwnedValidationCommand(x.w,{binary:process.execPath,args:['-e','process.exit(7)']});assert.equal(r.exitStatus,7);assert.equal(r.processGroupStopped,true);}finally{x.done();}});
for(const kind of ['pressure','failure','timeout','bound','cancel','command-timeout','log-limit'])test('REAL_CONTROLLED_EXECUTION abort/cleanup '+kind,async()=>{
 let calls=0;const controller=new AbortController();const x=await workspace(()=>{calls++;if(calls<4)return sample();
  if(kind==='failure')throw Error('synthetic monitor failure');if(kind==='timeout')return new Promise(()=>{});
  const s=sample();if(kind==='pressure')s.diskPressure=true;if(kind==='bound')s.domains[0].availableBytes=58*GiB;return s;});
 let timer;try{if(kind==='cancel')timer=setTimeout(()=>controller.abort(),100);
 const script=kind==='log-limit'?"process.stdout.write('x'.repeat(2*1024*1024));setInterval(()=>{},1000)":"setInterval(()=>{},1000)";
 const r=await runOwnedValidationCommand(x.w,{binary:process.execPath,args:['-e',script],signal:controller.signal,timeoutMs:kind==='command-timeout'?100:3000});
 assert.ok(r.error,kind);assert.equal(r.processGroupStopped,true);assert.ok(r.samples.length>=1);assert.equal(x.w.cleanup().ownedWorkspaceRemoved,true);
 }finally{clearTimeout(timer);x.done();}
});
test('REAL_CONTROLLED_EXECUTION missing binary fails and cleans',async()=>{const x=await workspace();try{const r=await runOwnedValidationCommand(x.w,{binary:x.parent+'/not-installed',args:[]});assert.match(r.error,/SPAWN_FAILED/);assert.equal(r.processGroupStopped,true);}finally{x.done();}});
test('foreign owner marker prevents recursive cleanup',async()=>{const x=await workspace();const marker=x.w.directory+'/.owner',old=fs.readFileSync(marker);try{fs.writeFileSync(marker,'foreign');assert.throws(()=>x.w.cleanup(),/OWNERSHIP_LOST/);assert.equal(fs.existsSync(x.w.directory),true);}finally{fs.writeFileSync(marker,old);x.done();}});
test('uncertain termination blocks deletion',async()=>{const x=await workspace();try{x.w.begin();assert.throws(()=>x.w.cleanup(),/NOT_PROVEN_SAFE/);x.w.end(false);assert.throws(()=>x.w.cleanup(),/NOT_PROVEN_SAFE/);}finally{fs.rmSync(x.parent,{recursive:true,force:true});}});
test('tool hash and owner capability required',async()=>{const x=await workspace();try{assert.throws(()=>createValidationRefreshIO({workspace:x.w,binary:process.execPath,binarySha256:'0'.repeat(64),assertOwner:()=>{}}),/NOT_PROVEN/);assert.throws(()=>createValidationRefreshIO({workspace:x.w,binary:process.execPath,binarySha256:sha(fs.readFileSync(process.execPath))}),/NOT_PROVEN/);}finally{x.done();}});
test('unreviewed artifact and invalid cache read denied',async()=>{const x=await workspace();try{const io=createValidationRefreshIO({workspace:x.w,binary:process.execPath,binarySha256:sha(fs.readFileSync(process.execPath)),assertOwner:()=>{}});await assert.rejects(io.download('db',{kind:'db',digest:'sha256:'+'c'.repeat(64)}),/BINDING/);assert.throws(()=>io.read('../production'),/INVALID_DATABASE_KIND/);assert.equal(io.receipt(),undefined);}finally{x.done();}});
test('environment and timeout overrides cannot weaken isolation',async()=>{const x=await workspace();try{await assert.rejects(runOwnedValidationCommand(x.w,{binary:process.execPath,args:[],env:{TRIVY_CACHE_DIR:'/home/scanner/.cache/trivy'}}),/OVERRIDE_DENIED/);await assert.rejects(runOwnedValidationCommand(x.w,{binary:process.execPath,args:[],timeoutMs:99999999}),/INVALID_VALIDATION_COMMAND/);}finally{x.done();}});

test('local storage sampler reads real statfs allocation and independent backing domains',async()=>{const d=temp();try{const observer=createLocalStorageSampler({domains:[{id:'local',path:d}],readState:async()=>({diskPressure:false,unownedWriter:false,ownerValid:true}),readBacking:async()=>[{id:'host',identity:'test-backing'}]});const x=await observer();assert.equal(x.domains.length,2);const f=fs.statfsSync(d,{bigint:true});assert.equal(x.domains[0].capacityBytes,Number(f.blocks*f.bsize));assert.ok(x.domains[0].availableBytes>0);assert.equal(x.domains[0].identity,'dev:'+fs.statSync(d).dev);assert.equal(x.ownerValid,true);}finally{fs.rmSync(d,{recursive:true,force:true});}});
test('validation upstream cannot inherit production proxy/provider',async()=>{const x=await workspace();try{const io=createValidationRefreshIO({workspace:x.w,binary:process.execPath,binarySha256:sha(fs.readFileSync(process.execPath)),assertOwner:()=>{}});await assert.rejects(io.upstream('db'),/EXPLICIT_VALIDATION_MANIFEST_PROVIDER/);}finally{x.done();}});
test('REAL_CONTROLLED_EXECUTION: SIGTERM-resistant owned process escalates to SIGKILL',async()=>{const controller=new AbortController(),x=await workspace();const t=setTimeout(()=>controller.abort(),300);try{const r=await runOwnedValidationCommand(x.w,{binary:process.execPath,args:['-e',"process.on('SIGTERM',()=>{});setInterval(()=>{},1000)"],signal:controller.signal});assert.equal(r.error,'VALIDATION_CANCELLED');assert.equal(r.commandSignal,'SIGKILL');assert.equal(r.processGroupStopped,true);}finally{clearTimeout(t);x.done();}});
test('REAL_CONTROLLED_EXECUTION: final storage unknown prevents success',async()=>{const x=await workspace(({phase}={})=>{if(phase==='final')throw Error('unknown');return sample();});try{const r=await runOwnedValidationCommand(x.w,{binary:process.execPath,args:['-e','process.exit(0)']});assert.equal(r.exitStatus,0);assert.equal(r.error,'FINAL_STORAGE_STATE_UNKNOWN');assert.equal(r.processGroupStopped,true);}finally{x.done();}});
test('REAL_CONTROLLED_EXECUTION: monitor event-loop gap cannot silently pass',async()=>{let n=0;const x=await workspace(()=>{if(++n===3){const until=Date.now()+1100;while(Date.now()<until){}}return sample();});try{const r=await runOwnedValidationCommand(x.w,{binary:process.execPath,args:['-e','setInterval(()=>{},1000)']});assert.equal(r.error,'MONITOR_SAMPLE_GAP');assert.equal(r.processGroupStopped,true);}finally{x.done();}});
test('symlink owner marker blocks cleanup without reading target',async()=>{const x=await workspace(),marker=x.w.directory+'/.owner',old=fs.readFileSync(marker);try{fs.unlinkSync(marker);fs.symlinkSync(x.parent+'/does-not-exist',marker);assert.throws(()=>x.w.cleanup(),/OWNERSHIP_LOST/);}finally{fs.unlinkSync(marker);fs.writeFileSync(marker,old);x.done();}});

test('both DB artifact identities are mandatory',()=>{const b=proof();delete b.artifactDigests['java-db'];assert.equal(assess(sample(),b).allowed,false);});
test('hard floor and monitor limits cannot be lowered by budget fields',()=>{const b=proof(),s=sample();b.hardFloorBytes=1;b.pollMs=999999;b.domains[0].hardFloorBytes=1;s.domains[0].availableBytes=22*GiB;assert.equal(assess(s,b).allowed,false);assert.equal(assess(s,b).domains[0].hardFloorBytes,23*GiB);});
