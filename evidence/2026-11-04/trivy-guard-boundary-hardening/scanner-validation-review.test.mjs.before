import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import {createHash} from 'node:crypto';
import {GiB,assessValidationBudget,createValidationWorkspace,createValidationRefreshIO,runOwnedValidationCommand,validationHardFloor,productionRefreshRequirement,validationLimits} from '../scanner-validation-guard.mjs';
import {requireFreshScannerMetadata} from '../scanner-db-refresh.mjs';
const sha=x=>createHash('sha256').update(x).digest('hex');
const proof=()=>({status:'PROVEN_CONSERVATIVE_UPPER_BOUND',artifactDigests:{db:'sha256:'+'a'.repeat(64),'java-db':'sha256:'+'b'.repeat(64)},evidenceSha256:'c'.repeat(64),evidenceIdentity:'SYNTHETIC_AUDIT_ONLY',domains:[{id:'guest',identity:'synthetic',capacityBytes:100*GiB,peakAdditionalBytes:4*GiB,instantaneousWriteBytes:GiB,cleanupBytes:GiB,otherWriterBytes:GiB,peakAdditionalInodes:100,instantaneousWindowMs:4000,boundIncludesDownloadExtractionOldNewTemp:true,boundIncludesScanAndReports:true,cleanupProven:true,backingAllocationProven:true}]});
const sample=()=>({at:Date.now(),diskPressure:false,unownedWriter:false,ownerValid:true,domains:[{id:'guest',identity:'synthetic',capacityBytes:100*GiB,availableBytes:64*GiB,inodesFree:100000}]});
async function work(){const parent=fs.mkdtempSync(path.join(os.tmpdir(),'trivy-audit-only-'));fs.chmodSync(parent,0o700);const w=await createValidationWorkspace({parent,runId:'trivy-validation-'+'e'.repeat(16),sample,budget:proof()});return {parent,w,clean(){w.cleanup();fs.rmSync(parent,{recursive:true});}};}
test('guard source and all numeric constants remain as accepted 4de943b',()=>{assert.equal(sha(fs.readFileSync('infra/observability/scanner-validation-guard.mjs')),'21c29ecdc38d2f0e20d64fd1d26d22228c680347b44f2a10292c64dbbc928c4a');assert.equal(validationHardFloor(100*GiB),23*GiB);assert.equal(productionRefreshRequirement(100*GiB),27*GiB);assert.deepEqual(validationLimits,{pollMs:100,maxSampleGapMs:1000,sampleTimeoutMs:500,termGraceMs:1000,killGraceMs:1000,maxLogBytes:1024**2,maxRunMs:210000,minimumInodes:4096});});
test('AUDIT_FINDING: complete actual filesystem coverage needs trusted external proof',()=>{const b=proof();assert.equal(assessValidationBudget(sample(),b).allowed,true);assert.equal(b.domains.length,1);assert.equal(b.domains.some(d=>d.id==='physical-host'),false);});
test('AUDIT_FINDING: readable cache metadata symlink can escape cache subtree',async()=>{const x=await work();try{fs.mkdirSync(x.w.cacheDir+'/db');const sentinel=x.parent+'/synthetic-public-metadata.json';fs.writeFileSync(sentinel,'{"syntheticOnly":true}');fs.symlinkSync(sentinel,x.w.cacheDir+'/db/metadata.json');const io=createValidationRefreshIO({workspace:x.w,binary:process.execPath,binarySha256:sha(fs.readFileSync(process.execPath)),assertOwner:()=>{}});assert.equal(io.read('db').syntheticOnly,true);}finally{x.clean();}});
test('AUDIT_FINDING: owned process group alone does not contain a detached descendant',async()=>{const x=await work();let escaped;let safe=false;try{
 const script="const fs=require('fs'),cp=require('child_process');const c=cp.spawn(process.execPath,['-e','setTimeout(()=>{},3000)'],{detached:true,stdio:'ignore'});fs.writeFileSync('escaped.pid',String(c.pid));c.unref();";
 const r=await runOwnedValidationCommand(x.w,{binary:process.execPath,args:['-e',script]});escaped=Number(fs.readFileSync(x.w.directory+'/escaped.pid','utf8'));assert.ok(Number.isSafeInteger(escaped)&&escaped>1);assert.equal(r.processGroupStopped,true);assert.doesNotThrow(()=>process.kill(escaped,0));
 }finally{
  if(escaped){try{process.kill(-escaped,'SIGTERM');}catch(e){if(e.code!=='ESRCH')throw e;}const until=Date.now()+4000;while(Date.now()<until){try{process.kill(escaped,0);}catch(e){if(e.code==='ESRCH'){safe=true;break;}throw e;}await new Promise(r=>setTimeout(r,25));}}else safe=true;
  assert.equal(safe,true,'Owned escaped fixture process not proven stopped; preserve directory and STOP');
  x.clean();
 }});
test('fresh metadata for BOTH schemas is required by unchanged production prerequisite',()=>{const now=Date.now(),stamp=x=>new Date(x).toISOString(),m=Object.fromEntries([['db',2],['java-db',1]].map(([k,Version])=>[k,{Version,UpdatedAt:stamp(now-60000),DownloadedAt:stamp(now-1000),NextUpdate:stamp(now+60000)}]));assert.doesNotThrow(()=>requireFreshScannerMetadata(m,now));for(const k of ['db','java-db']){const b=structuredClone(m);b[k].NextUpdate=stamp(now-1);assert.throws(()=>requireFreshScannerMetadata(b,now),/REFRESH_REQUIRED/);}});
test('schema/missing metadata cannot masquerade as usable DB',()=>{assert.throws(()=>requireFreshScannerMetadata({}));const now=Date.now(),m={db:{Version:99,NextUpdate:new Date(now+100000).toISOString()}};assert.throws(()=>requireFreshScannerMetadata(m,now));});
test('monitor timeout does not certify instantaneous or cleanup write bound',()=>{const b=proof();delete b.domains[0].instantaneousWriteBytes;assert.equal(assessValidationBudget(sample(),b).allowed,false);b.domains[0].instantaneousWriteBytes=GiB;delete b.domains[0].cleanupProven;assert.equal(assessValidationBudget(sample(),b).allowed,false);});
