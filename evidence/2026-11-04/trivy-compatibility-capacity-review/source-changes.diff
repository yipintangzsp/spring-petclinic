+test('new source identity is explicit, pinned and non-release',()=>{const r=verifyTrivySourceLock();assert.equal(r.baselineId,'helm-shadow-integration-v1');assert.equal(r.sourceIdentityChecks,13);assert.equal(r.helmIdentityChecks,33);assert.equal(r.restoredV1Sha256,old.sourceHashes['Jenkinsfile.security-audit']);assert.equal(r.lock.productionActivation,false);assert.equal(r.policyVersion,'baseline-v1');});
