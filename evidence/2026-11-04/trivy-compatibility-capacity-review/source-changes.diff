+test('Gate decision body byte-identical to archived original adapter',()=>{const a=fs.readFileSync(V+'trivy-parent.frozen-v1.mjs','utf8'),b=fs.readFileSync('infra/security/policy/trivy-parent.mjs','utf8');assert.equal(sha(a),'b0b6b034228e26ec8c9b4d052202505999ac9e5534f8106713e55eb6a4f167c6');assert.equal(a.slice(a.indexOf(' const absent=')),b.slice(b.indexOf(' const absent=')));});
+test('original source still selects the unmodified v1 baseline',()=>{const t=tree();try{fs.copyFileSync('infra/helm/baseline/Jenkinsfile.security-audit.v1.txt',t.root+'/Jenkinsfile.security-audit');const r=verifyTrivySourceLock({root:t.root});assert.equal(r.baselineId,'frozen-baseline-v1');assert.equal(r.helmIdentityChecks,0);assert.equal(r.manifestSha256,next.parentManifestSha256);}finally{t.done();}});
+for(const p of Object.keys(old.sourceHashes))test('unknown frozen-source edit fails closed: '+p,()=>{const t=tree();try{fs.appendFileSync(t.root+'/'+p,'\nUNKNOWN_CHANGE');assert.throws(()=>verifyTrivySourceLock({root:t.root}),/POLICY_ERROR/);}finally{t.done();}});
+for(const p of Object.keys(next.helmSourceHashes).filter(p=>!Object.hasOwn(old.sourceHashes,p)))test('unknown Helm-only source edit fails closed: '+p,()=>{const t=tree();try{fs.appendFileSync(t.root+'/'+p,'\nUNKNOWN_CHANGE');assert.throws(()=>verifyTrivySourceLock({root:t.root}),/POLICY_ERROR/);}finally{t.done();}});
+for(const name of ['trivy-parent-baseline-v1.json','trivy-parent-helm-shadow-v1.json'])test('manifest tampering cannot approve new SHA: '+name,()=>{const t=tree();try{fs.appendFileSync(t.root+'/'+V+name,' ');assert.throws(()=>verifyTrivySourceLock({root:t.root}),/manifest changed/);}finally{t.done();}});
+test('symlinked locked source is rejected',()=>{const t=tree();try{const p=t.root+'/infra/security/trivy-medium-review.json',copy=t.root+'/copy.json';fs.renameSync(p,copy);fs.symlinkSync(copy,p);assert.throws(()=>verifyTrivySourceLock({root:t.root}),/symlink locked/);}finally{t.done();}});
+test('missing locked source fails, never falls back to another manifest',()=>{const t=tree();try{fs.unlinkSync(t.root+'/infra/security/audit-trivy.mjs');assert.throws(()=>verifyTrivySourceLock({root:t.root}));}finally{t.done();}});
+test('non-Helm stage edit cannot be normalized away',()=>{const text=fs.readFileSync('Jenkinsfile.security-audit','utf8'),changed=text.replace("stage('Security Manager')","stage('Security Manager CHANGED')");assert.notEqual(sha(removePinnedHelmBlocks(changed)),old.sourceHashes['Jenkinsfile.security-audit']);});
+test('duplicate or malformed markers rejected',()=>{const text=fs.readFileSync('Jenkinsfile.security-audit','utf8');assert.throws(()=>removePinnedHelmBlocks(text+'\n// HELM_SHADOW_STAGES_BEGIN'),/ambiguous/);assert.throws(()=>removePinnedHelmBlocks(text.replace('// HELM_SHADOW_STAGES_END','// removed')),/ambiguous/);});
