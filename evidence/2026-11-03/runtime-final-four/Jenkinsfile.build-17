// Dedicated non-release boundary investigation. No production state writes.
pipeline {
 agent any
 options { disableConcurrentBuilds(); timeout(time: 5, unit: 'MINUTES') }
 stages {
  stage('Verify exact bundle and original baseline') { steps { sh 'node infra/security/runtime-facts/verify-bundle.mjs; node infra/security/runtime-facts/baseline-smoke.mjs' } }
  stage('Read real permission and candidate capabilities') { steps {
   withCredentials([usernamePassword(credentialsId:'harbor-creds',usernameVariable:'HARBOR_USER',passwordVariable:'HARBOR_PASS'),string(credentialsId:'defectdojo-api-token',variable:'DEFECTDOJO_TOKEN')]) { sh 'node infra/security/runtime-facts/four-discovery.mjs' }
  } }
 }
 post { always { archiveArtifacts artifacts: '.devsecops/runtime-controlled/build-' + env.BUILD_NUMBER + '/**,runtime-source-bundle.json', allowEmptyArchive: false } }
}
