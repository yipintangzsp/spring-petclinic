          }
        },
        "spec": {
          "nodeSelector": {
            "kubernetes.io/os": "linux",
            "kubernetes.io/hostname": "devops"
          },
          "tolerations": [
            {
              "key": "cloud",
              "operator": "Equal",
              "value": "true",
              "effect": "NoSchedule"
            }
          ],
          "topologySpreadConstraints": [
            {
              "maxSkew": 1,
              "topologyKey": "kubernetes.io/hostname",
              "whenUnsatisfiable": "ScheduleAnyway",
              "labelSelector": {
                "matchLabels": {
                  "app": "petclinic"
                }
              },
              "matchLabelKeys": [
                "pod-template-hash"
