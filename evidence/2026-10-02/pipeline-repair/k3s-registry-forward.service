[Unit]
Description=K3s registry TCP forward through existing Alibaba tunnel identity
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -i /etc/k3s-tunnel/id_ed25519 -o BatchMode=yes -o ConnectTimeout=15 -o ConnectionAttempts=2 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/k3s-tunnel/known_hosts -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -L 127.0.0.1:13050:10.0.0.3:30050 root@47.93.213.70
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
