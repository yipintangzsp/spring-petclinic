{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "argocd-application-controller",
            "env": [
              {
                "name": "GOMEMLIMIT",
                "value": "512MiB"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "384Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "768Mi"
              }
            }
          }
        ]
      }
    }
  }
}
