{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "Prometheus",
  "metadata": {
    "name": "kube-stack-kube-prometheus-prometheus",
    "namespace": "monitoring",
    "labels": {
      "app": "kube-prometheus-stack-prometheus",
      "app.kubernetes.io/instance": "kube-stack",
      "app.kubernetes.io/managed-by": "Helm",
      "app.kubernetes.io/part-of": "kube-prometheus-stack",
      "app.kubernetes.io/version": "84.3.0",
      "chart": "kube-prometheus-stack-84.3.0",
      "heritage": "Helm",
      "release": "kube-stack"
    }
  },
  "spec": {
    "affinity": {
      "podAntiAffinity": {
        "preferredDuringSchedulingIgnoredDuringExecution": [
          {
            "podAffinityTerm": {
              "labelSelector": {
                "matchExpressions": [
                  {
                    "key": "app.kubernetes.io/name",
                    "operator": "In",
                    "values": [
                      "prometheus"
                    ]
                  },
                  {
                    "key": "app.kubernetes.io/instance",
                    "operator": "In",
                    "values": [
                      "kube-stack-kube-prometheus-prometheus"
                    ]
                  }
                ]
              },
              "topologyKey": "kubernetes.io/hostname"
            },
            "weight": 100
          }
        ]
      }
    },
    "alerting": {
      "alertmanagers": [
        {
          "name": "alertmanager-platform",
          "namespace": "monitoring",
          "port": "web"
        }
      ]
    },
    "automountServiceAccountToken": true,
    "enableAdminAPI": false,
    "enableOTLPReceiver": false,
    "evaluationInterval": "30s",
    "externalUrl": "http://kube-stack-kube-prometheus-prometheus.monitoring:9090",
    "hostNetwork": false,
    "image": "127.0.0.1:30050/platform-upgrade/prometheus:v3.13.1-arm64",
    "imagePullPolicy": "IfNotPresent",
    "listenLocal": false,
    "logFormat": "logfmt",
    "logLevel": "info",
    "paused": false,
    "podMonitorNamespaceSelector": {},
    "podMonitorSelector": {
      "matchLabels": {
        "release": "kube-stack"
      }
    },
    "portName": "http-web",
    "probeNamespaceSelector": {},
    "probeSelector": {
      "matchLabels": {
        "release": "kube-stack"
      }
    },
    "replicas": 1,
    "resources": {
      "requests": {
        "memory": "400Mi"
      }
    },
    "retention": "1d",
    "routePrefix": "/",
    "ruleNamespaceSelector": {},
    "ruleSelector": {
      "matchLabels": {
        "release": "kube-stack"
      }
    },
    "scrapeConfigNamespaceSelector": {},
    "scrapeConfigSelector": {
      "matchLabels": {
        "release": "kube-stack"
      }
    },
    "scrapeInterval": "30s",
    "securityContext": {
      "fsGroup": 2000,
      "runAsGroup": 2000,
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "serviceAccountName": "kube-stack-kube-prometheus-prometheus",
    "serviceMonitorNamespaceSelector": {},
    "serviceMonitorSelector": {
      "matchLabels": {
        "release": "kube-stack"
      }
    },
    "shards": 1,
    "tsdb": {
      "outOfOrderTimeWindow": "0s"
    },
    "version": "v3.13.1",
    "walCompression": true
  }
}
