  "clusterAdminGrants": 0,
  "wildcardVerbsResources": 0,
  "saImpersonationReason": "v1.35 impersonation source uses namespace+name for ServiceAccount authorization; namespaced Role is sufficient. No users/groups/UID impersonation or alpha ConstrainedImpersonation.",
  "standardBootstrapDependencies": [
    "system:basic-user permits authenticated users (including impersonated SAs) create selfsubjectaccessreviews/selfsubjectrulesreviews",
    "system:discovery permits normal kubectl schema discovery/SSA validation; do not change production kubectl flags to bypass it"
  ],
  "sources": [
    "https://raw.githubusercontent.com/kubernetes/apiserver/v0.35.0/pkg/endpoints/filters/impersonation/impersonation.go",
    "https://raw.githubusercontent.com/kubernetes/kubernetes/v1.35.0/plugin/pkg/auth/authorizer/rbac/bootstrappolicy/policy.go"
  ],
  "negativeScope": {
    "reconcilerDenied": [
      "get devsecops-system/unrelated-secret",
      "list/create devsecops-system/secrets",
      "get petclinic/unrelated-secret",
      "list/create petclinic/secrets",
      "get data-infra/rabbitmq-auth"
    ],
    "verifierDenied": [
      "get petclinic/petclinic-harbor-pull",
      "get petclinic/petclinic-db",
      "list petclinic/secrets"
    ]
  },
  "managementIdentity": "Existing isolated fixture manager performs future creation/mutations/TokenRequest/cleanup through same approved guard; no management credential in MIN_RBAC_EXECUTOR. No mutation privileges assigned to executor.",
  "bootstrapDependencyFailure": "Stop if existing self access review/discovery unavailable; no fallback, no auto permission expansion."
