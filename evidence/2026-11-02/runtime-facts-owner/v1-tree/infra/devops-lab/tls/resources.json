{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "devops-lab",
        "labels": {
          "app.kubernetes.io/part-of": "devops-learning"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "name": "lab-budget",
        "namespace": "devops-lab",
        "labels": {
          "app.kubernetes.io/part-of": "devops-learning"
        }
      },
      "spec": {
        "hard": {
          "requests.cpu": "500m",
          "requests.memory": "512Mi",
          "limits.cpu": "2",
          "limits.memory": "1Gi",
          "requests.storage": "2Gi",
          "pods": "6",
          "count/services": "4"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "LimitRange",
      "metadata": {
        "name": "lab-defaults",
        "namespace": "devops-lab",
        "labels": {
          "app.kubernetes.io/part-of": "devops-learning"
        }
      },
      "spec": {
        "limits": [
          {
            "type": "Container",
            "defaultRequest": {
              "cpu": "25m",
              "memory": "32Mi"
            },
            "default": {
              "cpu": "250m",
              "memory": "128Mi"
            }
          }
        ]
      }
    },
    {
      "apiVersion": "cert-manager.io/v1",
      "kind": "Issuer",
      "metadata": {
        "name": "lab-selfsigned",
        "namespace": "devops-lab",
        "labels": {
          "app.kubernetes.io/part-of": "devops-learning"
        }
      },
      "spec": {
        "selfSigned": {}
      }
    },
    {
      "apiVersion": "cert-manager.io/v1",
      "kind": "Certificate",
      "metadata": {
        "name": "lab-root",
        "namespace": "devops-lab",
        "labels": {
          "app.kubernetes.io/part-of": "devops-learning"
        }
      },
      "spec": {
        "isCA": true,
        "commonName": "Petclinic DevOps Lab CA",
        "subject": {
          "organizations": [
            "Petclinic DevOps Learning"
          ]
        },
        "secretName": "lab-root-ca",
        "duration": "8760h",
        "renewBefore": "720h",
        "privateKey": {
          "algorithm": "ECDSA",
          "size": 256,
          "rotationPolicy": "Always"
        },
        "issuerRef": {
          "name": "lab-selfsigned",
          "kind": "Issuer",
          "group": "cert-manager.io"
        }
      }
    },
    {
      "apiVersion": "cert-manager.io/v1",
      "kind": "Issuer",
      "metadata": {
        "name": "lab-ca",
        "namespace": "devops-lab",
        "labels": {
          "app.kubernetes.io/part-of": "devops-learning"
        }
      },
      "spec": {
        "ca": {
          "secretName": "lab-root-ca"
        }
      }
    },
    {
      "apiVersion": "cert-manager.io/v1",
      "kind": "Certificate",
      "metadata": {
        "name": "tls-lab",
        "namespace": "devops-lab",
        "labels": {
          "app.kubernetes.io/part-of": "devops-learning"
        }
      },
      "spec": {
        "secretName": "tls-lab-tls",
        "dnsNames": [
          "tls-lab.devops.local"
        ],
        "duration": "168h",
        "renewBefore": "24h",
        "revisionHistoryLimit": 3,
        "privateKey": {
          "algorithm": "ECDSA",
          "size": 256,
          "rotationPolicy": "Always"
        },
        "issuerRef": {
          "name": "lab-ca",
          "kind": "Issuer",
          "group": "cert-manager.io"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "tls-lab-page",
        "namespace": "devops-lab",
        "labels": {
          "app.kubernetes.io/part-of": "devops-learning"
        }
      },
      "data": {
        "index.html": "<!doctype html><html lang=\"zh-CN\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>DevOps HTTPS 实验</title><body><h1>DevOps HTTPS 证书实验</h1><p>证书由实验 CA 签发，HTTPS 由现有 Traefik 提供。</p><p>实验范围：签发、信任校验、密钥换发和失败排查。</p><p>这是独立学习环境。浏览器默认不信任实验 CA；请使用运行手册中的 CA 校验命令。</p></body></html>"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "tls-lab",
        "namespace": "devops-lab",
        "labels": {
          "app.kubernetes.io/part-of": "devops-learning"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "tls-lab"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "tls-lab",
              "app.kubernetes.io/part-of": "devops-learning"
            }
          },
          "spec": {
            "nodeSelector": {
              "kubernetes.io/hostname": "devops",
              "kubernetes.io/os": "linux"
            },
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "web",
                "image": "core.harbor.domain/cook/cook@sha256:372e33fb6c3be30d263941a00f782df83c68b65b4267ceab32d0c390d855a780",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "24Mi",
                    "ephemeral-storage": "16Mi"
                  },
                  "limits": {
                    "cpu": "100m",
                    "memory": "64Mi",
                    "ephemeral-storage": "128Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": "http"
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": "http"
                  },
                  "periodSeconds": 20
                },
                "volumeMounts": [
                  {
                    "name": "page",
                    "mountPath": "/usr/share/nginx/html/index.html",
                    "subPath": "index.html",
                    "readOnly": true
                  },
                  {
                    "name": "temporary",
                    "mountPath": "/tmp"
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              }
            ],
            "volumes": [
              {
                "name": "page",
                "configMap": {
                  "name": "tls-lab-page"
                }
              },
              {
                "name": "temporary",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "tls-lab",
        "namespace": "devops-lab",
        "labels": {
          "app.kubernetes.io/part-of": "devops-learning"
        }
      },
      "spec": {
        "selector": {
          "app": "tls-lab"
        },
        "ports": [
          {
            "name": "http",
            "port": 80,
            "targetPort": "http"
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "tls-lab",
        "namespace": "devops-lab",
        "labels": {
          "app.kubernetes.io/part-of": "devops-learning"
        }
      },
      "spec": {
        "ingressClassName": "traefik",
        "tls": [
          {
            "hosts": [
              "tls-lab.devops.local"
            ],
            "secretName": "tls-lab-tls"
          }
        ],
        "rules": [
          {
            "host": "tls-lab.devops.local",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "tls-lab",
                      "port": {
                        "name": "http"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
