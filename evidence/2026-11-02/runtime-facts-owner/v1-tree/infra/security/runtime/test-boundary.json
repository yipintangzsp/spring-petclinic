{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "devsecops-test",
        "labels": {
          "petclinic.devops.local/owner": "platform-runtime-security",
          "pod-security.kubernetes.io/enforce": "restricted"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "name": "runtime-test-budget",
        "namespace": "devsecops-test"
      },
      "spec": {
        "hard": {
          "pods": "1",
          "requests.cpu": "100m",
          "requests.memory": "256Mi",
          "limits.cpu": "500m",
          "limits.memory": "512Mi",
          "persistentvolumeclaims": "0"
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "runtime-test-deny",
        "namespace": "devsecops-test"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    }
  ]
}
