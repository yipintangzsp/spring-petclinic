{
  "apiVersion": "v1",
  "kind": "ConfigMap",
  "metadata": {
    "name": "airflow-config",
    "namespace": "data-infra"
  },
  "data": {
    "airflow.cfg": "[celery]\nflower_url_prefix = \nsync_parallelism = 0\nworker_concurrency = 16\n\n[celery_kubernetes_executor]\nkubernetes_queue = kubernetes\n\n[core]\nauth_manager = airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager\ndags_folder = /opt/airflow/dags\nexecution_api_server_url = http://airflow-api-server:8080/execution/\nexecutor = KubernetesExecutor\nload_examples = False\n\n[dag_processor]\ndag_bundle_config_list = [{\"classpath\":\"airflow.dag_processing.bundles.local.LocalDagBundle\",\"kwargs\":{},\"name\":\"dags-folder\"}]\n\n[elasticsearch]\njson_format = True\nlog_id_template = {dag_id}_{task_id}_{execution_date}_{try_number}\n\n[elasticsearch_configs]\nmax_retries = 3\nretry_timeout = True\ntimeout = 30\n\n[fab]\nenable_proxy_fix = True\n\n[kerberos]\nccache = /var/kerberos-ccache/cache\nkeytab = /etc/airflow.keytab\nprincipal = airflow@FOO.COM\nreinit_frequency = 3600\n\n[kubernetes_executor]\nmulti_namespace_mode = False\nnamespace = data-infra\npod_template_file = /opt/airflow/pod_templates/pod_template_file.yaml\nworker_container_repository = apache/airflow\nworker_container_tag = 3.3.0\n\n[logging]\ncolored_console_log = False\nremote_logging = False\n\n[metrics]\nstatsd_host = airflow-statsd\nstatsd_on = True\nstatsd_port = 9125\nstatsd_prefix = airflow\n\n[scheduler]\nstandalone_dag_processor = True\n\n[webserver]\nenable_proxy_fix = True\n",
    "airflow_local_settings.py": "",
    "pod_template_file.yaml": "{\n  \"apiVersion\": \"v1\",\n  \"kind\": \"Pod\",\n  \"metadata\": {\n    \"name\": \"placeholder-name\",\n    \"namespace\": \"data-infra\",\n    \"labels\": {\n      \"app\": \"petclinic-analysis\",\n      \"component\": \"worker\"\n    }\n  },\n  \"spec\": {\n    \"restartPolicy\": \"Never\",\n    \"serviceAccountName\": \"airflow-worker\",\n    \"nodeSelector\": {\n      \"kubernetes.io/hostname\": \"devops\"\n    },\n    \"terminationGracePeriodSeconds\": 45,\n    \"activeDeadlineSeconds\": 180,\n    \"securityContext\": {\n      \"runAsUser\": 50000,\n      \"fsGroup\": 0\n    },\n    \"containers\": [\n      {\n        \"name\": \"base\",\n        \"image\": \"apache/airflow:3.3.0\",\n        \"env\": [\n          {\n            \"name\": \"AIRFLOW__CORE__FERNET_KEY\",\n            \"valueFrom\": {\n              \"secretKeyRef\": {\n                \"key\": \"fernet-key\",\n                \"name\": \"airflow-fernet-key\"\n              }\n            }\n          },\n          {\n            \"name\": \"AIRFLOW_HOME\",\n            \"value\": \"/opt/airflow\"\n          },\n          {\n            \"name\": \"AIRFLOW__DATABASE__SQL_ALCHEMY_CONN\",\n            \"valueFrom\": {\n              \"secretKeyRef\": {\n                \"key\": \"connection\",\n                \"name\": \"airflow-metadata\"\n              }\n            }\n          },\n          {\n            \"name\": \"AIRFLOW_CONN_AIRFLOW_DB\",\n            \"valueFrom\": {\n              \"secretKeyRef\": {\n                \"key\": \"connection\",\n                \"name\": \"airflow-metadata\"\n              }\n            }\n          },\n          {\n            \"name\": \"AIRFLOW__API__SECRET_KEY\",\n            \"valueFrom\": {\n              \"secretKeyRef\": {\n                \"key\": \"api-secret-key\",\n                \"name\": \"airflow-api-secret-key\"\n              }\n            }\n          },\n          {\n            \"name\": \"AIRFLOW__API_AUTH__JWT_SECRET\",\n            \"valueFrom\": {\n              \"secretKeyRef\": {\n                \"key\": \"jwt-secret\",\n                \"name\": \"airflow-jwt-secret\"\n              }\n            }\n          }\n        ],\n        \"envFrom\": [\n          {\n            \"secretRef\": {\n              \"name\": \"petclinic-analysis-db\"\n            }\n          }\n        ],\n        \"resources\": {\n          \"requests\": {\n            \"cpu\": \"100m\",\n            \"memory\": \"768Mi\"\n          },\n          \"limits\": {\n            \"cpu\": \"500m\",\n            \"memory\": \"768Mi\"\n          }\n        },\n        \"securityContext\": {\n          \"allowPrivilegeEscalation\": false,\n          \"capabilities\": {\n            \"drop\": [\n              \"ALL\"\n            ]\n          }\n        },\n        \"volumeMounts\": [\n          {\n            \"name\": \"logs\",\n            \"mountPath\": \"/opt/airflow/logs\"\n          },\n          {\n            \"name\": \"config\",\n            \"mountPath\": \"/opt/airflow/airflow.cfg\",\n            \"subPath\": \"airflow.cfg\",\n            \"readOnly\": true\n          },\n          {\n            \"name\": \"config\",\n            \"mountPath\": \"/opt/airflow/config/airflow_local_settings.py\",\n            \"subPath\": \"airflow_local_settings.py\",\n            \"readOnly\": true\n          },\n          {\n            \"name\": \"analysis-code\",\n            \"mountPath\": \"/opt/airflow/dags/petclinic_dag.py\",\n            \"subPath\": \"petclinic_dag.py\",\n            \"readOnly\": true\n          },\n          {\n            \"name\": \"analysis-code\",\n            \"mountPath\": \"/opt/airflow/dags/clinic_task.py\",\n            \"subPath\": \"clinic_task.py\",\n            \"readOnly\": true\n          }\n        ]\n      }\n    ],\n    \"volumes\": [\n      {\n        \"name\": \"logs\",\n        \"emptyDir\": {}\n      },\n      {\n        \"name\": \"config\",\n        \"configMap\": {\n          \"name\": \"airflow-config\"\n        }\n      },\n      {\n        \"name\": \"analysis-code\",\n        \"configMap\": {\n          \"name\": \"petclinic-analysis-code\"\n        }\n      }\n    ]\n  }\n}"
  }
}
