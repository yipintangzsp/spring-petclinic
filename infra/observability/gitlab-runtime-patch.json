{
  "spec": {
    "template": {
      "spec": {
        "containers": [{
          "name": "gitlab",
          "resources": {"requests": {"cpu": "250m", "memory": "2560Mi"}, "limits": {"memory": "4Gi"}},
          "startupProbe": {
            "exec": {"command": ["sh", "-c", "curl -fsS --max-time 5 http://127.0.0.1/-/readiness | grep -q '\"status\":\"ok\"'"]},
            "timeoutSeconds": 10, "periodSeconds": 10, "failureThreshold": 90
          },
          "readinessProbe": {
            "exec": {"command": ["sh", "-c", "curl -fsS --max-time 5 http://127.0.0.1/-/readiness | grep -q '\"status\":\"ok\"'"]},
            "timeoutSeconds": 10, "periodSeconds": 10, "failureThreshold": 3
          }
        }]
      }
    }
  }
}
