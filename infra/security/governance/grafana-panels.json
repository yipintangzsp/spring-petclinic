    },
    "gridPos": {
      "x": 0,
      "y": 34,
      "w": 24,
      "h": 5
    },
    "targets": [
      {
        "refId": "A",
        "expr": "{job=\"devsecops-security\",project=\"petclinic\"} | json summary=\"kubescape_framework_summary\" | summary!=\"\" | line_format \"{{.summary}}\"",
