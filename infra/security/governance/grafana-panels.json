[
  {
    "id": 13,
    "title": "Kubescape - scan status",
    "type": "stat",
    "description": "[governance-addon:v1] Real native results / DefectDojo API snapshot at latest Jenkins governance sync. No zero-fill. Runtime panels remain independent.",
    "datasource": {
      "type": "loki",
      "uid": "loki"
    },
    "gridPos": {
      "x": 0,
      "y": 30,
      "w": 6,
      "h": 4
    },
    "targets": [
      {
        "refId": "A",
        "expr": "last_over_time({job=\"devsecops-security\",project=\"petclinic\"} | json value=\"kubescape_scan_success\" | value!=\"\" | unwrap value | __error__=\"\" [24h])",
        "legendFormat": "Engine status",
        "queryType": "instant",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        }
      }
    ],
    "options": {
      "reduceOptions": {
        "calcs": [
          "lastNotNull"
        ],
        "fields": "",
        "values": false
      },
      "orientation": "auto",
      "textMode": "auto",
      "colorMode": "value"
    },
    "fieldConfig": {
      "defaults": {
        "unit": "short",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "red",
              "value": null
            },
            {
              "color": "green",
              "value": 1
            }
          ]
        },
        "mappings": [
          {
            "type": "value",
            "options": {
              "0": {
                "text": "FAILED",
                "color": "red"
              },
              "1": {
                "text": "SUCCESS",
                "color": "green"
              }
            }
          }
        ]
      },
      "overrides": []
    }
  },
