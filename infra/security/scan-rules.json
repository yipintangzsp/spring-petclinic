{
  "rules": [
    {"id":"java-runtime-exec","languages":["java"],"severity":"ERROR","message":"Unreviewed OS command execution","pattern":"Runtime.getRuntime().exec(...)"},
    {"id":"java-process-builder","languages":["java"],"severity":"ERROR","message":"Unreviewed process construction","pattern":"new ProcessBuilder(...)"},
    {"id":"java-sql-concatenation","languages":["java"],"severity":"ERROR","message":"Concatenated SQL passed to Statement","pattern-either":[{"pattern":"$S.executeQuery($A + $B)"},{"pattern":"$S.executeUpdate($A + $B)"},{"pattern":"$S.execute($A + $B)"}]},
    {"id":"java-weak-digest","languages":["java"],"severity":"ERROR","message":"Weak cryptographic digest","pattern-either":[{"pattern":"MessageDigest.getInstance(\"MD5\")"},{"pattern":"MessageDigest.getInstance(\"SHA-1\")"}]},
    {"id":"java-weak-cipher","languages":["java"],"severity":"ERROR","message":"Weak cipher or ECB mode","pattern-either":[{"pattern":"Cipher.getInstance(\"DES\")"},{"pattern":"Cipher.getInstance(\"AES/ECB/PKCS5Padding\")"}]},
    {"id":"java-disabled-tls-hostname-check","languages":["java"],"severity":"ERROR","message":"Globally disabled HTTPS hostname verification","pattern":"HttpsURLConnection.setDefaultHostnameVerifier(...)"}
  ]
}
