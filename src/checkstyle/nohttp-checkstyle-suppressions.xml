<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
		"-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
		"https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Existing private Harbor service has no TLS listener; exact signing client and existing service only. -->
    <suppress files="infra[\\/]security[\\/]signing\.mjs$" checks="NoHttp" message=".*http://harbor-core\.harbor\.svc\.cluster\.local.*"/>
    <!-- Existing cluster-local monitoring and canary HTTP listeners used for real probes. -->
    <suppress files="infra[\\/]devops-lab[\\/]rollouts[\\/]resources\.json$" checks="NoHttp" message=".*http://(delivery-canary\.rollouts-lab\.svc\.cluster\.local:8080/|kube-stack-kube-prometheus-prometheus\.monitoring\.svc\.cluster\.local:9090).*"/>
    <!-- Official vendored cert-manager CRD descriptions contain these two HTTP examples only. -->
    <suppress files="infra[\\/]devops-lab[\\/]cert-manager[\\/]upstream\.yaml$" checks="NoHttp" message=".*http://(ca\.domain\.com/ca\.crt|ocsp\.int-x3\.letsencrypt\.org).*"/>
    <!-- Existing cluster-private GitLab endpoint; bootstrap Applications do not expose it publicly. -->
    <suppress files="infra[\\/]devops-lab[\\/]applications[\\/](platform-cert-manager|devops-tls-lab|platform-rollouts|rollouts-lab|platform-rabbitmq|platform-messaging|platform-airflow)\.json$" checks="NoHttp" message=".*http://gitlab-service\.ns-devops\.svc\.cluster\.local/root/petclinic-platform\.git.*"/>

    <!-- Existing private GitLab SCM service has no TLS listener. -->
    <suppress files="k8s[\\/]production[\\/]alertmanager-application\.yaml$" checks="NoHttp" message=".*http://gitlab-service\.ns-devops\.svc\.cluster\.local/root/petclinic-platform\.git.*"/>
    <!-- The existing local egress proxy is HTTP; destination TLS remains verified. -->
    <suppress files="Jenkinsfile$" checks="NoHttp" message=".*http://192\.168\.1\.238:10808.*"/>
    <suppress files="infra[\\/]harbor[\\/]trivy-arm64-patch\.json$" checks="NoHttp" message=".*http://192\.168\.1\.238:10808.*"/>
    <!-- Recovery documentation records the same existing LAN listeners. -->
    <suppress files="docs[\\/]RECOVERY-20261014\.md$" checks="NoHttp" message=".*http://(petclinic|superset|jenkins)\.devops\.local/.*"/>
    <!-- These documented existing LAN listeners have no TLS endpoint. -->
    <suppress files="docs[\\/]OPERATIONS-20261011\.md$" checks="NoHttp" message=".*http://([a-z-]+\.devops\.local|core\.harbor\.domain)/.*"/>
    <!-- This runbook documents only the two existing private HTTP listeners. -->
    <suppress files="docs[\\/]RABBITMQ-INTEGRATION-20261023\.md$" checks="NoHttp" message=".*http://(petclinic|rabbitmq)\.devops\.local(/.*)?'.*"/>
    <!-- Preserve the verified private Jenkins listener; no HTTPS endpoint is configured. -->
    <suppress files="docs[\\/]TERRAFORM-ISOLATION-20261025\.md$" checks="NoHttp" message=".*http://192\.168\.64\.11:30659/job/petclinic-ci/197/.*"/>
    <!-- Probe the existing LAN ingress through SSH; this listener has no TLS. -->
    <suppress files="infra[\\/]analytics[\\/]controlled\.py$" checks="NoHttp" message=".*http://192\.168\.1\.58.*"/>
    <!-- These two internal endpoints currently have no TLS listener; preserve their real URLs. -->
    <suppress files="docs[\\/]UPGRADE-20261005\.md$" checks="NoHttp" message=".*http://192\.168\.1\.236:10808.*"/>
    <suppress files="infra[\\/]data[\\/]verify-demo-browser\.cjs$" checks="NoHttp" message=".*http://petclinic\.devops\.local.*"/>
    <!-- SonarQube is the existing cluster-local HTTP service, not a public endpoint. -->
    <suppress files="Jenkinsfile" checks="NoHttp" message=".*sonarqube-sonarqube\.sonarqube\.svc\.cluster\.local:9000.*"/>
    <!-- Existing in-cluster OTLP services use HTTP; keep this exception scoped to telemetry manifests. -->
    <suppress files="k8s[\\/]production[\\/]petclinic(-v09-dashboard)?.yaml|infra[\\/]observability[\\/].*" checks="NoHttp"/>
	<!-- Captured production HTML and acceptance scripts preserve actual endpoint URLs. -->
	<suppress files="evidence[\\/].*" checks="NoHttp"/>
	<suppress files="node_modules[\\/].*" checks=".*"/>
	<suppress files="node[\\/].*" checks=".*"/>
	<suppress files="build[\\/].*" checks=".*"/>
	<suppress files="target[\\/].*" checks=".*"/>
	<suppress files=".+\.(jar|git|ico|p12|gif|jks|jpg|png|svg|log)" checks="NoHttp"/>
</suppressions>
